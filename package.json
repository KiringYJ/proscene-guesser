{
  "name": "proscene-guesser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --open /dev/round-fixture.html",
    "build": "run-s questions:check build:app",
    "build:app": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:sync": "node scripts/sync-liquipedia-catalog.ts",
    "questions:sync": "node scripts/sync-question-catalog.ts",
    "questions:check": "node scripts/sync-question-catalog.ts --check",
    "fixture:check": "node scripts/check-dev-fixture-excluded.ts",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "check": "run-s questions:check type-check lint test build-only fixture:check"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.5.41",
    "vuetify": "^4.1.8"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
